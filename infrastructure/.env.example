# COGNO - Variables de entorno para producción
# Copiar a .env y completar con tus valores

# ===================
# BASE DE DATOS
# ===================
DATABASE_URL=postgresql://smatc:smatc123@postgres:5432/smatc

# ===================
# REDIS
# ===================
REDIS_URL=redis://redis:6379/0

# ===================
# S3 / MinIO
# ===================
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=videos

# ===================
# DIRECTORIOS
# ===================
UPLOAD_TMP_DIR=/shared/uploads
FRAMES_DIR=/shared/uploads/frames

# ===================
# OPENAI (Requerido para fusión de análisis)
# Obtener de: https://platform.openai.com/api-keys
# ===================
OPENAI_API_KEY=sk-tu-key-aqui

# ===================
# DEEPGRAM (Diarización + Transcripción)
# Obtener de: https://console.deepgram.com/signup
# ===================
DEEPGRAM_API_KEY=dg_tu_key
DEEPGRAM_MODEL=nova-2

# ===================
# WHISPER (Configuración de idioma, aún usada por Deepgram)
# ===================
WHISPER_LANGUAGE=es

# ===================
# CELERY (Workers)
# ===================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0